# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# 이 파일을 .env로 복사하고 필요한 키만 본인 값으로 채운다.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# OpenAI 임베딩 또는 OpenAI 답변 생성에 필요. 실제 계정에 과금되는 원격 API 키다.
# 절대 커밋하지 말고 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# 새 실행 방법: bash sh/run_agent_hybrid.sh
# 답변 생성은 Ollama Qwen을 유지하고 문서·질문의 임베딩만 OpenAI API로 보낸다.
LLM_BACKEND=ollama
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 실측 전 임시값. evals/compare_embeddings.py --split dev --calibrate로 결정한다.
RAG_MIN_SCORE=0.50
# 기존 로컬 검색: --embedding-provider ollama (Qwen 임베딩 설치 필요)
# 직접 server.py 실행 시에는 provider=ollama, model=qwen3-embedding:0.6b를 함께 설정한다.
# SESSION_DB_PATH=/absolute/path/to/demo-session.db
